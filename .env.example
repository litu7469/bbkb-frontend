# Copy to .env.local (dev) or configure in your hosting provider (prod).
# All NEXT_PUBLIC_* values are exposed to the browser — never put real secrets here.

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8006

# Supabase (public anon key is safe to expose; protect data with Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
